<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_primary" />
            <stroke android:width="1.5dp" android:color="#FFFFFF" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/accent_primary_light" />
            <corners android:radius="5dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/dialog_surface" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
            <corners android:radius="5dp" />
        </shape>
    </item>
</selector>
