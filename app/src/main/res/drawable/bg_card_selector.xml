<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focused state for D-pad navigation: Sony Purple Accent -->
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_focused" />
            <stroke android:width="1.5dp" android:color="@color/border_focused" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Pressed state -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_focused" />
            <stroke android:width="1.5dp" android:color="@color/accent_gold" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <!-- Normal state -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/bg_surface_card" />
            <stroke android:width="1dp" android:color="@color/border_subtle" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
