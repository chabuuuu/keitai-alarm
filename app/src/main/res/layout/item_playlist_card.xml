<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_card_selector"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="8dp">

    <!-- Folder Icon / Indicator -->
    <TextView
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_pill_badge"
        android:gravity="center"
        android:text="📁"
        android:textSize="14sp" />

    <!-- Info Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvPlaylistName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Tên Playlist"
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPlaylistTrackCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:text="0 bài hát"
            android:textColor="@color/accent_gold"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Delete button hint -->
    <TextView
        android:id="@+id/btnDeletePlaylist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="4dp"
        android:text="[*] Xóa"
        android:textColor="@color/accent_danger"
        android:textSize="10sp" />

</LinearLayout>
