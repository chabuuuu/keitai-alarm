<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="3dp"
    android:layout_marginBottom="3dp"
    android:background="@drawable/bg_card_selector"
    android:clickable="true"
    android:focusable="true"
    android:orientation="vertical"
    android:padding="8dp">

    <!-- Top Row: Clock Time and ON/OFF Pill -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAlarmTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:includeFontPadding="false"
            android:letterSpacing="0.02"
            android:text="07:00"
            android:textColor="@color/text_primary"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAlarmStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_badge"
            android:paddingStart="7dp"
            android:paddingTop="2dp"
            android:paddingEnd="7dp"
            android:paddingBottom="2dp"
            android:text="BẬT"
            android:textColor="@color/accent_success"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Middle Row: Label and Repeat Days -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAlarmLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Thức dậy buổi sáng"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvAlarmRepeat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="T2 T3 T4 T5 T6"
            android:textColor="@color/accent_primary_light"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Bottom Row: Ringtone Info & Full Song Tag -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tvAlarmRingtone"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="🎵 [Random] Playlist"
            android:textColor="@color/accent_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tvFullSongBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[Full bài]"
            android:textColor="@color/accent_gold"
            android:textSize="10sp" />
    </LinearLayout>

</LinearLayout>
