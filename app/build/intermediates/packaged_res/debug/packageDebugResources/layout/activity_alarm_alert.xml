<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fitsSystemWindows="true"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="12dp"
    android:paddingBottom="0dp">

    <!-- Top Badge -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_pill_badge"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="12dp"
        android:paddingBottom="4dp"
        android:text="🔔 BÁO THỨC ĐANG REO"
        android:textColor="@color/accent_primary_light"
        android:textSize="11sp"
        android:textStyle="bold" />

    <!-- Current Time -->
    <TextView
        android:id="@+id/tvAlertClock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:includeFontPadding="false"
        android:letterSpacing="0.04"
        android:text="07:00"
        android:textColor="@color/text_primary"
        android:textSize="38sp"
        android:textStyle="bold" />

    <!-- Date info -->
    <TextView
        android:id="@+id/tvAlertDate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Thứ 2, 28/10/2026"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- Alarm Label -->
    <TextView
        android:id="@+id/tvAlertLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="THỨC DẬY BUỔI SÁNG"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Song Info Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_card_selector"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ĐANG PHÁT FULL BÀI:"
            android:textColor="@color/accent_gold"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvAlertSongTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="2"
            android:text="🎵 Tên bài hát.mp3"
            android:textColor="@color/text_primary"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Action Buttons for Keypad -->
    <Button
        android:id="@+id/btnDismiss"
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/bg_button_selector"
        android:focusable="true"
        android:text="[OK / Phím 5]  TẮT BÁO THỨC"
        android:textColor="@color/accent_danger"
        android:textSize="13sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSnooze"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_button_selector"
        android:focusable="true"
        android:text="[0 / Phím *]  BÁO LẠI 10 PHÚT"
        android:textColor="@color/accent_primary_light"
        android:textSize="12sp"
        android:textStyle="bold" />

    <!-- Softkey Navigation Guide Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:background="@drawable/bg_softkey_guide"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingTop="4dp"
        android:paddingEnd="8dp"
        android:paddingBottom="6dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[0] Báo lại  |  [OK / 5] TẮT BÁO THỨC"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
